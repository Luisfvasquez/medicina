FROM php:8.4-cli-alpine
# Install system packages & PostgreSQL dev libraries
RUN apk add --no-cache \
    postgresql-dev \
    libpng-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    curl \
    oniguruma-dev \
    icu-dev

# Install PHP extensions required by Laravel & PostgreSQL
RUN docker-php-ext-install \
    pdo \
    pdo_pgsql \
    pgsql \
    gd \
    zip \
    bcmath \
    pcntl \
    mbstring \
    intl

# Get latest Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy composer manifests
COPY composer.json composer.lock* ./

# Install dependencies without running scripts initially
RUN composer install --no-interaction --no-scripts --prefer-dist

# Copy application code
COPY . .

# Run post-install scripts and set permissions
RUN composer run-script post-autoload-dump || true
RUN chmod -R 777 storage bootstrap/cache

EXPOSE 8000

CMD sh -c "\
cp .env.docker .env && \
php artisan config:clear || true && \
php artisan route:clear || true && \
php artisan view:clear || true && \
php artisan migrate --force && \
php artisan cache:clear || true && \
php artisan serve --host=0.0.0.0 --port=8000"
